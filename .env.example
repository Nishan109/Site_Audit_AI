GEMINI_API_KEY=your_key_here
# Optional preferred model. Available Flash-Lite alternatives are tried on failure.
GEMINI_MODEL=gemini-3.5-flash
# Optional separate PageSpeed Insights API key, to use your project's quota.
PAGESPEED_API_KEY=
# Supabase Project URL and publishable key from the project's Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for inserting verified audit snapshots.
SUPABASE_SECRET_KEY=
# Exact origin, including the port. Set to the deployed HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Match Authentication > Security and Protection > Password settings.
SUPABASE_PASSWORD_MIN_LENGTH=6
